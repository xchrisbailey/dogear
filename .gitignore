.DS_Store
.build/
.swiftpm/
xcuserdata/
# Generated by XcodeGen from project.yml, except Package.resolved: the lockfile for the
# app's packages lives where Xcode reads it, and XcodeGen leaves it in place.
Dogear.xcodeproj/*
!Dogear.xcodeproj/project.xcworkspace/
Dogear.xcodeproj/project.xcworkspace/*
!Dogear.xcodeproj/project.xcworkspace/xcshareddata/
Dogear.xcodeproj/project.xcworkspace/xcshareddata/*
!Dogear.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
Dogear.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Dogear.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
